<?xml version="1.0" encoding="utf-8"?>
<project>
	

	<!-- ========================================================================= -->
	<!-- META INFORMATION                                                          -->
	<!-- ========================================================================= -->
	<meta title="ALTAURI" package="com.virtualik.altauri" version="1.0.0" company="ViRTUALiK" />
	
	<!-- ========================================================================= -->
	<!-- APPLICATION ENTRY POINTS 🐧🤖🪟🌐                                          -->
	<!-- ========================================================================= -->
	<!-- Use a single Main class for different platforms -->
	<app main="Main" file="ALTAURI_Windows"  path="bin" if="windows" />
	<app main="Main" file="ALTAURI_Android"  path="bin" if="android" />
	<app main="Main" file="ALTAURI_Linux"    path="bin" if="linux" />
	<app main="Main" file="ALTAURI_Web"      path="bin" if="html5" />
	
	<!-- For Android, explicitly specify the output type -->
	<!-- <output type="Application" mainClass="Main" /> -->
	
	
	
	<!-- ========================================================================= -->
	<!-- WINDOW SETTINGS                                                           -->
	<!-- ========================================================================= -->
	<!-- General settings for all platforms -->
	<window hardware="true" vsync="true" allow-shaders="true" antialiasing="0" fps="60" />
	
	<!-- Windows / C++ Specific Settings -->
	<window if="cpp"
        visible="false"
        borderless="true"
        resizable="true"
        allow-high-dpi="false"
        width="1024"
        height="600"
        background="#FF00FF"
        transparent="true"
        render="webgl" hardware="true" vsync="true" />
	
	<!-- Specific settings for HTML5 -->
	<!-- CASE 1 FOR THE ENTIRE BROWSER: Don't set the width and height so the browser automatically adjusts the canvas to 1:1 -->
	<!-- window if="html5" background="#FFFFFF"	allow-high-dpi="false" -->

	<!-- CASE 2 FOR DIV AREA: Fixed size for demo widget, eg 800x400 -->
	<window if="html5" width="1024" height="600" background="#1E1E1E" />
	<window if="html5" render="webgl" hardware="true" vsync="true" />

	<config:android sdk="C:\AndroidSDK" ndk="C:\AndroidSDK\ndk\21.4.7075529" />

	<!-- ========================================================================= -->
	<!-- ENVIRONMENT VARIABLES (C++ Only)                                          -->
	<!-- ========================================================================= -->
	
	<setenv name="OPENFL_DISABLE_DIRTY_REGIONS" value="true" if="cpp" />
	<setenv name="LIME_RENDER_CONTEXT" value="opengl" if="cpp" />
	
	<!-- ========================================================================= -->
	<!-- SOURCE PATHS                                                              -->
	<!-- ========================================================================= -->
	<source path="src" />
	
	<haxelib name="openfl" />
	<haxelib name="hxcpp" if="cpp" />
	<haxedef name="utf8" />
	
        <!-- ══════════════════════════════════════════════════════════════
			ALTAURI BLACK BOX (utils.Trap): crash_trap.log,
			stderr_capture.log + native SEH guard.
			ENABLED BY DEFAULT (both lines below are commented out).
			SILENT build, without log files: uncomment line 1.
			Quiet only release (debug remains chatty): line 2. -->
        <haxedef name="ALTAURI_TRAP_OFF" />
		<haxedef name="ALTAURI_TRAP_OFF" if="release" />
	
	<assets path="assets" embed="true" />
	<assets path="assets/icons/atoms" rename="assets/icons/atoms" recursive="true" embed="true"/> -->
	<icon path="assets/favicon.ico" embed="true"/> -->
    <!-- ========================================================================= -->
    <!-- ANDROID CONFIGURATION & USB SERIAL & JAVA-WEBSOCKET DEPENDENCIES          -->
    <!-- ========================================================================= -->
	<section if="android">
		<!-- USB Host feature (для ComPort) -->
		<android feature="android.hardware.usb.host" />
		
		<!-- INTERNET permission (для WebSocket) -->
		<android permission="android.permission.INTERNET" />
		
		<!-- Include the unpacked classes.jar from the .aar file (for ComPort) -->
		<java path="libs/android/java/usb-serial-extracted/classes.jar" />
		
		<!-- Connecting the Java-WebSocket library (for WebSocket) -->
		<java path="libs/Java-WebSocket-1.5.6.jar" />
		
	    <!-- SLF4J DEPENDENCIES (required for Java-WebSocket) -->
		<java path="libs/slf4j-api-1.7.36.jar" />
		<java path="libs/slf4j-nop-1.7.36.jar" />
		
		<!-- Tells Lime where the Java sources are located -->
		<java path="libs/android/java/src/" />
	</section>
	
	<!-- We run synchronization only for HTML5 and only locally (the script will not run on CI) -->
	<postbuild if="html5" unless="CI" command="powershell -ExecutionPolicy Bypass -File sync-to-atelier.ps1"/>

</project>