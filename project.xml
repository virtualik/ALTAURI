<?xml version="1.0" encoding="utf-8"?>
<project>
		
	<meta title="ALTAURI" package="com.virtualik.altauri" version="1.0.0" company="ViRTUALiK" />
	
	<!-- Условная компиляция главного класса -->
    <app main="MainHTML5" if="html5" />
    <app main="Main" if="cpp" file="ALTAURI" path="bin" />
	
	<output type="Application" mainClass="Main" />
	<window visible="false"
			borderless="true"
			hardware="true"
			vsync="true"
			allow-shaders="true"
			antialiasing="0"
			allow-high-dpi="false"
			width="1280" height="800"
			fps="60"
			background="#FF00FF"
			transparent="true">
	</window>/>
	
	<setenv name="OPENFL_DISABLE_DIRTY_REGIONS" value="true" />
	<setenv name="LIME_RENDER_CONTEXT" value="opengl" />
	
	<source path="src" />
	
	<haxelib name="openfl" version="9.5.1"/>
	<haxelib name="hxcpp" if="cpp" />
	<haxedef name="utf8" />
	<icon path="assets/openfl.svg" />
</project>