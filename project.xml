<?xml version="1.0" encoding="utf-8"?>
<project>
		
	<meta title="ALTAURI" package="com.virtualik.altauri" version="1.0.0" company="ViRTUALiK" />
	<app main="Main" file="ALTAURI" path="bin" />
	<output type="Application" mainClass="Main" />
	<window  visible="false"
			 borderless="false"
			 hardware="true"
			 vsync="true"
			 allow-shaders="true"
			 antialiasing="4"
			 allow-high-dpi="false"
			 width="1024" height="800"
			 fps="60"
			 background="#000000"
			 transparent="true"/>
	
	<setenv name="OPENFL_DISABLE_DIRTY_REGIONS" value="true" />
	<setenv name="LIME_RENDER_CONTEXT" value="opengl" />
	
	<source path="src" />

	<!-- === КРИТИЧЕСКИ ВАЖНО: Правильный синтаксис для Lime 8.x === -->
    <!-- Путь должен быть относительно project.xml -->
    <cpp>
        <compilerflag value="-I${project.path}/include" />
    </cpp>
    
    <!-- Альтернативный вариант для MSVC (если -I не работает) -->
    <windows>
        <compilerflag value="/I${project.path}/include" if="cpp" />
    </windows>
    <!-- ========================================================= -->
	
	<haxelib name="openfl" />
	<haxelib name="hxcpp" if="cpp" />
	
	<icon path="assets/openfl.svg" />
</project>