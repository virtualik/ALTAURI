<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- NMML reference: https://gist.github.com/1763850 -->

	<!-- metadata, make sure 'package' is at least 3 segments (ie. com.mycompany.myproject) -->
	<meta title="ALTAURI" package="ALTAURI" version="1.0.0" company="ViRTUALiK" />

	<!-- output -->
	<app main="Main" file="ALTAURI" path="bin" />
	
	<window  visible="false"
			 borderless="true"
			 hardware="true"
			 vsync="true"
			 allow-shaders="true"
			 antialiasing="0"
			 allow-high-dpi="false"
			 width="1024" height="800"
			 fps="120" />
	
	<setenv name="OPENFL_DISABLE_DIRTY_REGIONS" value="true" />
	<setenv name="LIME_RENDER_CONTEXT" value="opengl" />
	
	<!-- classpath, haxe libs -->
	<source path="src" />
	<haxelib name="openfl" />

	<!-- assets -->
	<icon path="assets/openfl.svg" />

</project>