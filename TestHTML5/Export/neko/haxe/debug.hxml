-main ApplicationMain 
--macro openfl.utils._internal.ExtraParamsMacro.include()
-cp C:/HaxeToolkit/haxe/lib/openfl/9,4,0/src
-D openfl=9.4.0
--macro lime._internal.macros.DefineMacro.run()
-cp C:/HaxeToolkit/haxe/lib/lime/8,1,3/src
-D lime=8.1.3
-cp Source
-D lime-openal
-D native
-D lime-curl
-D openfl-native
-D hl.command=C:\HaxeToolkit\hl\hl.exe
-D lime-harfbuzz
-D tools=8.1.3
-D lime-cairo
-D lime-opengl
-D no-compilation
-D disable_preloader_assets=1
-D lime-native
-D lime-vorbis
-D lime-cffi
-D fdb
-D windows
-D desktop
--remap flash:openfl
-cp Export/neko/haxe
-neko Export/neko/obj/ApplicationMain.n
--macro keep("Main")
-debug